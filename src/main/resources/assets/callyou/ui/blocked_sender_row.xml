<?xml version="1.0" encoding="UTF-8" ?>
<ldlib2-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Low-Drag-MC/LDLib2/refs/heads/1.21/ldlib2-ui.xsd">
    <root id="blocked-sender-row" style="flex-direction: row; gap-horizontal: 4; width: 100%; align-items: center;">
        <element id="blocked-info" style="flex-direction: column; gap-vertical: 1; flex-grow: 1;">
            <label id="blocked-name" style="width: 100%;"></label>
            <label id="blocked-uuid" style="width: 100%; text-color: #888888;"></label>
        </element>
        <button id="unblock-button" text="screen.callyou.blocked_senders.unblock" style="width: 70; height: 16;"/>
    </root>
</ldlib2-ui>