<?xml version="1.0" encoding="UTF-8" ?>
<ldlib2-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Low-Drag-MC/LDLib2/refs/heads/1.21/ldlib2-ui.xsd">
    <root id="history-row" style="flex-direction: column; gap-vertical: 2; width: 100%; padding-all: 4;">
        <element id="history-header-row" style="flex-direction: row; gap-horizontal: 4; width: 100%; align-items: center;">
            <label id="history-header" style="flex-grow: 1;"></label>
            <button id="history-delete" style="width: 16; height: 16; overlay: sprite(callyou:textures/gui/icon/delete.png);"/>
        </element>
        <element id="history-body-slot" style="width: 100%;"></element>
        <element id="history-action-row" style="flex-direction: row; gap-horizontal: 4; width: 100%; align-items: center;">
            <button id="history-coords" visible="false" style="display: none; width: 16; height: 16; overlay: sprite(callyou:textures/gui/icon/map.png);"/>
            <button id="history-reply" visible="false" style="display: none; width: 16; height: 16; overlay: sprite(callyou:textures/gui/icon/reply.png);"/>
            <button id="history-read" style="width: 16; height: 16; overlay: sprite(callyou:textures/gui/icon/read.png);"/>
        </element>
        <element id="history-reply-group" visible="false" style="display: none; flex-direction: row; gap-horizontal: 4; width: 100%; align-items: center;">
            <text-field id="history-reply-input" style="flex-grow: 1; height: 16;"/>
            <button id="history-reply-send" style="width: 16; height: 16; overlay: sprite(callyou:textures/gui/icon/send.png);"/>
        </element>
    </root>
</ldlib2-ui>
